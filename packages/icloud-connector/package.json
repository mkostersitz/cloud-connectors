{
  "name": "icloud-connector",
  "version": "0.1.1",
  "description": "MCP connector for Claude Desktop: iCloud Mail (IMAP/SMTP) and iCloud Drive (local sync folder)",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "dependencies": {
    "@cloud-connectors/core": "*",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "imapflow": "^1.0.191",
    "mailparser": "^3.7.0",
    "nodemailer": "^7.0.0",
    "trash": "^9.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/mailparser": "^3.4.0",
    "@types/node": "^26.1.1",
    "@types/nodemailer": "^7.0.0",
    "typescript": "^7.0.2"
  }
}
